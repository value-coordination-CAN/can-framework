DATABASE_URL=postgresql+psycopg://can:can@db:5432/can

# Keycloak / OIDC
OIDC_ISSUER=http://keycloak:8080/realms/can
OIDC_AUDIENCE=can-api

# CAN-issued DID session JWT.
# Outside ENV=dev/test the app refuses to start unless this is a random value of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CAN_JWT_SECRET=change-me
CAN_JWT_ALG=HS256
CAN_DID_SESSION_TTL_SECONDS=900

# Keyed hash for external identifiers (imported connections). Same rule as CAN_JWT_SECRET.
EXTERNAL_ID_PEPPER=change-me

# Auth mode: oidc | did | hybrid
AUTH_MODE=hybrid
ENV=dev
